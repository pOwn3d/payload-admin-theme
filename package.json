{
  "name": "@consilioweb/payload-admin-theme",
  "version": "0.5.0",
  "packageManager": "pnpm@11.25.0",
  "description": "Payload CMS plugin — customize admin panel appearance with theming, branding, and CSS variables",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./rsc": {
      "import": {
        "types": "./dist/rsc.d.ts",
        "default": "./dist/rsc.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/check-build-artifacts.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "verify:build": "node scripts/check-build-artifacts.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "payload",
    "payload-cms",
    "payload-plugin",
    "admin-theme",
    "theming",
    "branding",
    "css-variables",
    "customization",
    "nextjs",
    "react",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pOwn3d/payload-admin-theme.git"
  },
  "homepage": "https://github.com/pOwn3d/payload-admin-theme#readme",
  "bugs": {
    "url": "https://github.com/pOwn3d/payload-admin-theme/issues"
  },
  "author": "ConsilioWEB <contact@consilioweb.fr> (https://consilioweb.fr)",
  "license": "MIT",
  "peerDependencies": {
    "@payloadcms/ui": "^3.79.1",
    "payload": "^3.79.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "devDependencies": {
    "@payloadcms/ui": "^3.88.0",
    "@types/react": "^19.2.18",
    "next": "^15.5.25",
    "payload": "^3.88.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
